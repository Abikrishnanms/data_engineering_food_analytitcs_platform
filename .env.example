# =============================================================================
# FoodFlow Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# =============================================================================

# PostgreSQL Connection Settings
FOODFLOW_DB_HOST=localhost
FOODFLOW_DB_PORT=5432
FOODFLOW_DB_NAME=foodflow
FOODFLOW_DB_USER=postgres
FOODFLOW_DB_PASSWORD=your_password_here

# Read-Only Analytics Role (Used by NLQ & Dashboard query runner)
FOODFLOW_ANALYTICS_USER=foodflow_analytics
FOODFLOW_ANALYTICS_PASSWORD=analytics_secure_pass

# Optional Anthropic API Key for NLQ LLM Translation
# If not provided, FoodFlow automatically falls back to safe rule-based translation.
ANTHROPIC_API_KEY=
